{
 "model": "ear",
 "version": "0.2.1",
 "task": "spoken-language-identification",
 "audio": {
  "sample_rate": 16000,
  "channels": 1,
  "window_seconds": 30,
  "recommended_windows": 3,
  "note": "Sample windows spread across the recording, not the first 90 seconds. Average the probabilities across windows rather than counting votes."
 },
 "frontend": {
  "n_fft": 400,
  "hop_length": 160,
  "n_mels": 80,
  "frames": 3000,
  "window": "hann_periodic",
  "log": "log10",
  "clamp_min": 1e-10,
  "floor_below_peak_db": 8,
  "affine": {
   "add": 4.0,
   "divide": 4.0
  },
  "input_shape": [
   1,
   80,
   3000
  ],
  "input_layout": "log-mel, mel-major; computed by the SDK in host code",
  "computed_by": "the SDK, in host code",
  "filterbank": "mel_filters.f32"
 },
 "artifacts": {
  "coreml": {
   "file": "ear.mlmodelc",
   "precision": "fp16",
   "compression": "palette6-tensor-pos8",
   "input": "mel",
   "output": "logits"
  },
  "litert": {
   "file": "ear.tflite",
   "quantization": "int8-hadamard",
   "input": "mel",
   "output": "output_0"
  },
  "filterbank": {
   "file": "mel_filters.f32",
   "layout": "uint32 mels, uint32 bins, then mels*bins float32, little-endian, mel-major"
  }
 },
 "output": {
  "logits": 103,
  "order": "languages.json",
  "decision": "argmax over averaged softmax across windows"
 },
